<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Eztravel" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- While the app starts: the logo on navy, as on the launcher icon. -->
    <style name="Theme.Eztravel.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Eztravel</item>
    </style>
</resources>
